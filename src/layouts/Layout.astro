---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Bug bounty hunter, security researcher, tool maker.",
  image = "/og.png"
} = Astro.props;

const siteTitle = "Nooblogaurus";
const fullTitle = title === "Home" ? siteTitle : `${title} | ${siteTitle}`;

// Canonical URL - prevents duplicate content issues
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nooblogaurus.online');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://nooblogaurus.online')} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@NoobosaurusR3x" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site || 'https://nooblogaurus.online')} />
    
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Client-side view transitions (SPA-like navigation) -->
    <ClientRouter />
    
    <!-- Fonts - Preload for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" as="style">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <title>{fullTitle}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Reading progress bar -->
    <div id="reading-progress" aria-hidden="true"></div>

    <!-- Skip link for keyboard navigation -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-[var(--color-accent)] focus:text-black focus:px-4 focus:py-2 focus:rounded"
    >
      Aller au contenu principal
    </a>
    <Nav />
    <main id="main-content" class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />

    <script>
      // Reading progress bar. Window listeners bind once (module runs once);
      // astro:page-load resets on each view-transition navigation.
      function updateProgress() {
        const b = document.getElementById('reading-progress');
        if (!b) return;
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        if (max < 200) { b.style.width = '0'; return; }
        b.style.width = ((doc.scrollTop / max) * 100) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);

      // Code blocks: wrap each <pre> with a language label + copy button.
      function enhanceCodeBlocks() {
        const blocks = document.querySelectorAll('.prose-article pre, .prose-sheet pre');
        blocks.forEach((pre) => {
          if (pre.dataset.enhanced) return;
          pre.dataset.enhanced = 'true';

          const code = pre.querySelector('code');
          const langClass = code
            ? Array.from(code.classList).find((c) => c.startsWith('language-'))
            : null;
          const lang = langClass ? langClass.replace('language-', '') : 'code';

          const wrap = document.createElement('div');
          wrap.className = 'code-wrap';
          const bar = document.createElement('div');
          bar.className = 'code-bar';
          const langEl = document.createElement('span');
          langEl.className = 'code-lang';
          langEl.textContent = lang;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.textContent = 'copy';
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code ? code.innerText : '');
              btn.textContent = 'copied';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.textContent = 'copy';
                btn.classList.remove('copied');
              }, 1500);
            } catch {
              btn.textContent = 'error';
            }
          });

          bar.appendChild(langEl);
          bar.appendChild(btn);
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(bar);
          wrap.appendChild(pre);
        });
      }

      document.addEventListener('astro:page-load', () => {
        updateProgress();
        enhanceCodeBlocks();
      });
    </script>
  </body>
</html>
